{
  "name": "sortly",
  "version": "1.0.0",
  "description": "Aplicativo desktop para organizar arquivos por extensão de forma rápida e segura.",
  "main": "electron/main.js",
  "author": "Caio Fernandes dos Reis",
  "license": "MIT",
  "homepage": "https://github.com/caiofdev/sortly",
  "repository": {
    "type": "git",
    "url": "https://github.com/caiofdev/sortly.git"
  },
  "bugs": {
    "url": "https://github.com/caiofdev/sortly/issues"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "tailwindcss",
    "organizador",
    "arquivos"
  ],
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --prefix frontend run dev",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "build:renderer": "npm --prefix frontend run build",
    "build": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "music-metadata": "^11.12.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sortly.app",
    "productName": "Sortly",
    "copyright": "Copyright © 2026 Caio Fernandes dos Reis",
    "executableName": "Sortly",
    "artifactName": "Sortly-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend/dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app-logo.ico"
    },
    "nsis": {
      "installerIcon": "electron/assets/app-logo.ico",
      "uninstallerIcon": "electron/assets/app-logo.ico",
      "shortcutName": "Sortly",
      "uninstallDisplayName": "Sortly"
    }
  }
}
